# Local development environment for sigenevlocal2mqtt

CHARGER_HOST=192.168.50.36
CHARGER_PORT=21319

POLL_INTERVAL_SECONDS=5
SLOW_POLL_MULTIPLIER=4
MIN_CURRENT=6
MAX_CURRENT=16
ENABLE_DANGEROUS_COMMANDS=false

MQTT_HOST=core-mosquitto
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password
MQTT_CLIENT_ID=sigenevlocal2mqtt-dev
MQTT_TOPIC_PREFIX=dev/sigen_evac_local
DEVICE_NAME=Sigen EV AC Local

LOG_LEVEL=DEBUG
