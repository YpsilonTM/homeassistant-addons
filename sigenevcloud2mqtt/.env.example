# Local development environment for sigenevcloud2mqtt

SIGEN_USERNAME=your_mysigen_email@example.com
SIGEN_PASSWORD=your_mysigen_password
SIGEN_REGION=eu

POLL_INTERVAL_SECONDS=15
MIN_CURRENT=6
MAX_CURRENT=16

MQTT_HOST=core-mosquitto
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password
MQTT_CLIENT_ID=sigenevcloud2mqtt-dev
MQTT_TOPIC_PREFIX=dev/sigen_evac
DEVICE_NAME=Sigen EV AC

LOG_LEVEL=DEBUG
